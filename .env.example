# ============================================================
# ForgeLoop Official Hackathon Evaluation Configuration
# ============================================================

# Official evaluation API key (consumed automatically by DeepSeek, Qwen, etc.)
AI_API_KEY=your-api-key-here

# Target Model Provider: deepseek | qwen | gemini | openai
MODEL_PROVIDER=deepseek

# Target Model Name (optional, defaults per provider)
# DeepSeek: deepseek-chat | deepseek-reasoner
# Qwen: qwen-plus | qwen2.5-coder-32b-instruct
# Gemini: gemini-1.5-flash
# OpenAI: gpt-4o-mini
MODEL_NAME=deepseek-chat

# Custom Base URL (optional override)
# MODEL_BASE_URL=https://api.deepseek.com/v1

# Alternative provider-specific keys (if not using AI_API_KEY)
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port (default: 4000)
PORT=4000
